# Server Configuration
PORT=5000
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# JWT Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Database Connection (PostgreSQL / Prisma / MongoDB)
DATABASE_URL=postgresql://user:password@localhost:5432/bookify_db?schema=public

# Optional: Redis Configuration (for caching & socket adapter)
REDIS_HOST=localhost
REDIS_PORT=6379
