# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRES_IN=7d

# ─── Database (MongoDB) ───────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/bookify_db
# Or use MongoDB Atlas:
# MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/bookify_db

# ─── Razorpay (Payment Gateway) ───────────────────────────────────────────────
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ─── ISBN Auto-Fill (Optional — Google Books API key) ─────────────────────────
# Without a key the API still works but at lower rate limits.
# Get a free key at: https://console.cloud.google.com/
GOOGLE_BOOKS_API_KEY=your_google_books_api_key_here

# ─── Email (Brevo / Sendinblue — for OTP & order notifications) ───────────────
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_NAME=Bookify
BREVO_SENDER_EMAIL=noreply@bookify.com

# ─── SMS OTP (Twilio — for phone OTP) ────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ─── Redis (Optional — for Socket.io multi-node scaling) ─────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
